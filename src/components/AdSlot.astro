---
interface Props {
  adSlot: string;
  label: string;
  width?: number;
  height?: number;
}

const { adSlot, label, width, height } = Astro.props;
const fixed = Boolean(width && height);
---

<div
  class:list={['ad-slot', { 'ad-slot-fixed': fixed }]}
  data-label={label}
  style={fixed ? `width:${width}px;height:${height}px` : undefined}
>
  {fixed ? (
    <ins
      class="adsbygoogle"
      style={`display:inline-block;width:${width}px;height:${height}px`}
      data-ad-client="ca-pub-8094444885520451"
      data-ad-slot={adSlot}></ins>
  ) : (
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client="ca-pub-8094444885520451"
      data-ad-slot={adSlot}
      data-ad-format="auto"
      data-full-width-responsive="true"></ins>
  )}
</div>
<script is:inline>
  (window.adsbygoogle = window.adsbygoogle || []).push({});
</script>
