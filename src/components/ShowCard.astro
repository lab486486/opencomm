---
import { cardImage } from '../lib/images';
import { categoryLabel, entryPath, showDate, type ShowEntry } from '../lib/shows';

interface Props {
  entry: ShowEntry;
  priority?: boolean;
}

const { entry, priority = false } = Astro.props;
const thumb = cardImage(entry.data.thumbnail);
---

<article class="show-card">
  <a class="card-link" href={entryPath(entry)}>
    {thumb && (
      <div class="show-thumb">
        <img
          src={thumb}
          alt=""
          width="640"
          height="400"
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={priority ? 'high' : 'low'}
        />
      </div>
    )}
    <div class="show-body">
      <p class="meta">{categoryLabel(entry)} · {entry.data.channel || showDate(entry)}</p>
      <h3>{entry.data.name}</h3>
    </div>
  </a>
</article>
