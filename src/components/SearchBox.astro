---
interface Props {
  value?: string;
  autofocus?: boolean;
}

const { value = '', autofocus = false } = Astro.props;
---

<form class="search-form" action="/search/" method="get">
  <label class="visually-hidden" for="q">방송 검색</label>
  <input
    id="q"
    type="search"
    name="q"
    value={value}
    placeholder="드라마, 예능, 채널 이름을 입력하세요"
    required
    autofocus={autofocus}
  />
  <button type="submit">검색</button>
</form>
