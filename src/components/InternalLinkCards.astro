---
import type { InternalLinkCard } from '../lib/internalLinkCards';

interface Props {
  cards: Record<string, InternalLinkCard>;
}

const { cards } = Astro.props;
const hasCards = Object.keys(cards).length > 0;
---

{
  hasCards && (
    <script define:vars={{ cards }}>
      function normalize(path: string) {
        let value = String(path || '').trim();
        if (!value) return '';
        try {
          value = decodeURIComponent(value);
        } catch {
          // keep raw
        }
        if (!value.startsWith('/')) value = `/${value}`;
        if (!value.endsWith('/')) value = `${value}/`;
        return value;
      }

      function isBarePath(text: string) {
        return /^\/(?:[A-Za-z0-9\-._~]|%[0-9A-Fa-f]{2}|[가-힣])+\/?$/.test(String(text || '').trim());
      }

      function lookup(path: string) {
        const raw = String(path || '').trim();
        return cards[raw] || cards[normalize(raw)] || null;
      }

      function buildCard(card: { href: string; title: string; thumbnail?: string }) {
        const a = document.createElement('a');
        a.className = 'internal-link-card';
        a.href = card.href;
        if (card.thumbnail) {
          const img = document.createElement('img');
          img.src = card.thumbnail;
          img.alt = '';
          img.width = 64;
          img.height = 64;
          img.loading = 'lazy';
          img.decoding = 'async';
          a.appendChild(img);
        } else {
          const ph = document.createElement('span');
          ph.className = 'internal-link-card-ph';
          ph.setAttribute('aria-hidden', 'true');
          ph.textContent = (card.title || '?').slice(0, 1);
          a.appendChild(ph);
        }
        const title = document.createElement('span');
        title.className = 'internal-link-card-title';
        title.textContent = card.title;
        a.appendChild(title);
        return a;
      }

      function run() {
        const prose = document.querySelector('.prose');
        if (!prose) return;

        prose.querySelectorAll('p').forEach((p) => {
          if (p.closest('a, .internal-link-card')) return;
          const text = (p.textContent || '').trim();
          if (!isBarePath(text)) return;
          const card = lookup(text);
          if (!card) return;
          p.replaceWith(buildCard(card));
        });

        const walker = document.createTreeWalker(prose, NodeFilter.SHOW_TEXT);
        const nodes: Text[] = [];
        while (walker.nextNode()) nodes.push(walker.currentNode as Text);

        for (const node of nodes) {
          if (!node.parentElement) continue;
          if (node.parentElement.closest('a, .internal-link-card, script, style')) continue;
          const text = (node.nodeValue || '').trim();
          if (!isBarePath(text)) continue;
          const card = lookup(text);
          if (!card) continue;
          const parent = node.parentElement;
          if (parent.tagName === 'P' && parent.childNodes.length === 1) {
            parent.replaceWith(buildCard(card));
          } else {
            node.replaceWith(buildCard(card));
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run, { once: true });
      } else {
        run();
      }
    </script>
  )
}
