---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  preloadImage?: string;
}

const {
  title,
  description = site.description,
  canonical,
  image,
  noindex = false,
  preloadImage,
} = Astro.props;

const pageTitle = title ? `${title} - ${site.name}` : `${site.name} 통합 검색`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <link rel="sitemap" href="/sitemap.xml" />}
    {!noindex && (
      <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss" />
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={new URL(image, site.url).href} />}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  </head>
  <body>
    <Header />
    <main class="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
    {!noindex && (
      <script is:inline>
        // Defer AdSense until after load + idle so LCP/TBT aren't blocked by ads JS.
        (function () {
          var CLIENT =
            'ca-pub-8094444885520451';
          var SRC =
            'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + CLIENT;
          function inject() {
            if (document.querySelector('script[data-adsense-loader]')) return;
            var s = document.createElement('script');
            s.async = true;
            s.src = SRC;
            s.crossOrigin = 'anonymous';
            s.dataset.adsenseLoader = '1';
            document.head.appendChild(s);
          }
          function schedule() {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(inject, { timeout: 2500 });
            } else {
              setTimeout(inject, 1800);
            }
          }
          if (document.readyState === 'complete') schedule();
          else window.addEventListener('load', schedule, { once: true });
        })();
      </script>
    )}
  </body>
</html>
