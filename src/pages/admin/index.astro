---
import Base from '../../layouts/Base.astro';
import { categories } from '../../lib/categories';
---

<Base title="방송 글 작성" description="드라마 지시를 넣습니다." noindex>
  <section class="admin-page">
    <p class="kicker">관리자</p>
    <h1 class="page-title">방송 글 넣기</h1>
    <p class="lede">
      본문 에디터가 아닙니다. 제목과 방송 정보만 넣으면 대기 목록에 쌓이고,
      GitHub Action이 DeepSeek로 글을 만든 뒤 Cloudflare에 올립니다.
    </p>

    <div class="admin-tabs" role="tablist">
      <button type="button" class="is-active" data-tab="write" role="tab" aria-selected="true">글 작성</button>
      <button type="button" data-tab="queue" role="tab" aria-selected="false">작성 대기</button>
      <button type="button" data-tab="posts" role="tab" aria-selected="false">발행된 글</button>
    </div>

    <section id="panel-write" class="admin-panel" data-panel="write">
      <form id="show-form" class="write-form">
        <label>
          <span>드라마 / 프로그램 제목</span>
          <input type="text" name="name" required placeholder="예: 신병4" autocomplete="off" />
        </label>
        <label>
          <span>카테고리</span>
          <select name="category" required>
            {categories.map((category) => (
              <option value={category.slug}>{category.name}</option>
            ))}
          </select>
        </label>
        <label>
          <span>방송국</span>
          <input type="text" name="channel" placeholder="예: ENA, SBS, tvN" />
        </label>
        <label>
          <span>방송 기간</span>
          <input type="text" name="period" placeholder="2026년 8월 24일 ~ 2026년 9월 29일" />
        </label>
        <label>
          <span>방송 시간</span>
          <input type="text" name="time" placeholder="월 · 화 / 오후 10:00 ~" />
        </label>
        <label>
          <span>회차</span>
          <input type="text" name="episodes" placeholder="12부작" />
        </label>
        <label>
          <span>주요 출연진</span>
          <input type="text" name="cast" placeholder="배우 이름" />
        </label>
        <label>
          <span>연출 및 작가</span>
          <input type="text" name="staff" />
        </label>
        <label>
          <span>시놉시스 및 줄거리</span>
          <textarea name="synopsis" rows="4"></textarea>
        </label>
        <label>
          <span>대표 썸네일 주소</span>
          <input type="url" name="thumbnail_url" placeholder="https://" />
        </label>
        <label>
          <span>썸네일 파일</span>
          <input type="file" name="thumbnail_file" accept="image/jpeg,image/png,image/webp,image/gif" />
        </label>
        <label>
          <span>유튜브 영상 주소</span>
          <input type="url" name="youtubeUrl" />
        </label>
        <label>
          <span>실시간 방송 주소</span>
          <input type="url" name="watchUrl" placeholder="공식 온에어 또는 내부 채널 글" />
        </label>
        <label>
          <span>메모 / 참고 내용</span>
          <textarea name="note" rows="3"></textarea>
        </label>
        <label class="choice">
          <input type="checkbox" name="featured" checked />
          <span>홈 최근 안내에 우선 노출</span>
        </label>
        <p id="form-status" class="form-status" role="status"></p>
        <button type="submit" class="primary-btn">대기 목록에 넣기</button>
      </form>
    </section>

    <section id="panel-queue" class="admin-panel is-hidden" data-panel="queue" hidden>
      <ul id="queue-list" class="admin-list"></ul>
    </section>

    <section id="panel-posts" class="admin-panel is-hidden" data-panel="posts" hidden>
      <ul id="post-list" class="admin-list"></ul>
    </section>

    <section id="panel-edit" class="admin-panel is-hidden" data-panel="edit" hidden>
      <button type="button" class="primary-btn" id="edit-back" style="width:auto;background:#111;">목록으로</button>
      <form id="edit-form" class="write-form">
        <input type="hidden" name="file" />
        <p class="permalink" id="edit-permalink"></p>
        <label>
          <span>프로그램 이름</span>
          <input type="text" name="name" required />
        </label>
        <label>
          <span>페이지 제목</span>
          <input type="text" name="title" required />
        </label>
        <label>
          <span>카테고리</span>
          <select name="category" required>
            {categories.map((category) => (
              <option value={category.slug}>{category.name}</option>
            ))}
          </select>
        </label>
        <label>
          <span>한 줄 설명</span>
          <textarea name="excerpt" rows="3"></textarea>
        </label>
        <label>
          <span>방송국</span>
          <input type="text" name="channel" />
        </label>
        <label>
          <span>실시간 주소</span>
          <input type="url" name="watchUrl" />
        </label>
        <label>
          <span>유튜브</span>
          <input type="url" name="youtubeUrl" />
        </label>
        <label>
          <span>썸네일</span>
          <input type="text" name="thumbnail" />
        </label>
        <label>
          <span>본문 (HTML)</span>
          <textarea name="body" rows="14"></textarea>
        </label>
        <label class="choice">
          <input type="checkbox" name="featured" />
          <span>홈 최근 안내에 우선 노출</span>
        </label>
        <label class="choice">
          <input type="checkbox" name="hiddenFromList" />
          <span>목록에서 숨김 (주소는 유지)</span>
        </label>
        <p id="edit-status" class="form-status" role="status"></p>
        <button type="submit" class="primary-btn">글 저장</button>
      </form>
    </section>
  </section>
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.admin-tabs button');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  const form = document.querySelector<HTMLFormElement>('#show-form');
  const editForm = document.querySelector<HTMLFormElement>('#edit-form');
  const statusEl = document.querySelector<HTMLElement>('#form-status');
  const editStatus = document.querySelector<HTMLElement>('#edit-status');
  const queueList = document.querySelector<HTMLElement>('#queue-list');
  const postList = document.querySelector<HTMLElement>('#post-list');
  const permalinkEl = document.querySelector<HTMLElement>('#edit-permalink');

  function showTab(name: string) {
    tabs.forEach((tab) => {
      const active = tab.dataset.tab === name;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    panels.forEach((panel) => {
      const active = panel.dataset.panel === name;
      panel.hidden = !active;
      panel.classList.toggle('is-hidden', !active);
    });
    if (name === 'queue') void loadQueue();
    if (name === 'posts') void loadPosts();
  }

  function setStatus(message: string, kind: 'ok' | 'error' | '') {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.dataset.kind = kind;
  }

  function setEditStatus(message: string, kind: 'ok' | 'error' | '') {
    if (!editStatus) return;
    editStatus.textContent = message;
    editStatus.dataset.kind = kind;
  }

  async function loadQueue() {
    if (!queueList) return;
    try {
      const res = await fetch('/api/show-queue/');
      const data = await res.json();
      const items = Array.isArray(data.items) ? data.items : [];
      if (!items.length) {
        queueList.innerHTML = '<li class="empty">대기 중인 글이 없습니다.</li>';
        return;
      }
      queueList.innerHTML = items
        .map((item: { name: string; category: string; status: string; note: string }) => {
          const label =
            item.status === 'pending' ? '대기' : item.status === 'done' ? '완료' : item.status === 'error' ? '오류' : item.status;
          return `<li><strong>${item.name}</strong><span>${item.category}${item.note ? ` · ${item.note}` : ''}</span><em>${label}</em></li>`;
        })
        .join('');
    } catch {
      queueList.innerHTML = '<li class="empty">npm run dev 로 사이트를 켜 주세요.</li>';
    }
  }

  async function loadPosts() {
    if (!postList) return;
    try {
      const res = await fetch('/api/show-posts/');
      const data = await res.json();
      const items = Array.isArray(data.items) ? data.items : [];
      if (!items.length) {
        postList.innerHTML = '<li class="empty">발행된 글이 없습니다.</li>';
        return;
      }
      postList.innerHTML = items
        .map(
          (item: { file: string; name: string; title: string; path: string; hiddenFromList: boolean }) =>
            `<li>
              <strong>${item.name}</strong>
              <span>${item.title}${item.hiddenFromList ? ' · 목록 숨김' : ''}</span>
              <span>${item.path}</span>
              <div class="admin-actions">
                <button type="button" data-edit="${item.file}">수정</button>
                <a href="${item.path}">보기</a>
              </div>
            </li>`,
        )
        .join('');
    } catch {
      postList.innerHTML = '<li class="empty">npm run dev 로 사이트를 켜 주세요.</li>';
    }
  }

  async function openEdit(file: string) {
    setEditStatus('불러오는 중…', '');
    showTab('edit');
    const res = await fetch(`/api/show-post/?file=${encodeURIComponent(file)}`);
    const post = await res.json();
    if (!res.ok) throw new Error(post.error || '글을 열지 못했습니다.');
    if (!editForm) return;
    const field = (key: string) => editForm.elements.namedItem(key) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    const check = (key: string) => editForm.elements.namedItem(key) as HTMLInputElement;
    field('file').value = post.file;
    field('name').value = post.name || '';
    field('title').value = post.title || '';
    field('category').value = post.category || 'drama';
    field('excerpt').value = post.excerpt || '';
    field('channel').value = post.channel || '';
    field('watchUrl').value = post.watchUrl || '';
    field('youtubeUrl').value = post.youtubeUrl || '';
    field('thumbnail').value = post.thumbnail || '';
    field('body').value = post.body || '';
    check('featured').checked = Boolean(post.featured);
    check('hiddenFromList').checked = Boolean(post.hiddenFromList);
    if (permalinkEl) permalinkEl.textContent = `퍼머링크 고정: ${post.legacyPath || `/${post.entrySlug}/`}`;
    setEditStatus('', '');
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => showTab(tab.dataset.tab || 'write'));
  });

  postList?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const file = target.dataset.edit;
    if (!file) return;
    void openEdit(file).catch((error) => {
      setEditStatus(error instanceof Error ? error.message : '글을 열지 못했습니다.', 'error');
    });
  });

  document.querySelector('#edit-back')?.addEventListener('click', () => showTab('posts'));

  editForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(editForm);
    setEditStatus('저장 중…', '');
    try {
      const res = await fetch('/api/show-post/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          file: String(data.get('file') || ''),
          name: String(data.get('name') || '').trim(),
          title: String(data.get('title') || '').trim(),
          category: String(data.get('category') || ''),
          excerpt: String(data.get('excerpt') || '').trim(),
          channel: String(data.get('channel') || '').trim(),
          watchUrl: String(data.get('watchUrl') || '').trim(),
          youtubeUrl: String(data.get('youtubeUrl') || '').trim(),
          thumbnail: String(data.get('thumbnail') || '').trim(),
          body: String(data.get('body') || ''),
          featured: data.get('featured') === 'on',
          hiddenFromList: data.get('hiddenFromList') === 'on',
        }),
      });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || '저장 실패');
      setEditStatus('저장했습니다. 퍼머링크는 그대로입니다.', 'ok');
    } catch (error) {
      setEditStatus(error instanceof Error ? error.message : '저장에 실패했습니다.', 'error');
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form) return;
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    let thumbnail = String(data.get('thumbnail_url') || '').trim();
    const file = data.get('thumbnail_file');
    setStatus('저장 중…', '');
    try {
      if (file instanceof File && file.size > 0) {
        const buffer = await file.arrayBuffer();
        const bytes = new Uint8Array(buffer);
        let binary = '';
        bytes.forEach((byte) => {
          binary += String.fromCharCode(byte);
        });
        const upload = await fetch('/api/show-upload/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            filename: file.name,
            mime: file.type,
            data: btoa(binary),
          }),
        });
        const uploaded = await upload.json();
        if (!upload.ok) throw new Error(uploaded.error || '이미지 업로드 실패');
        thumbnail = uploaded.url;
      }

      const res = await fetch('/api/show-queue/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          category: String(data.get('category') || ''),
          channel: String(data.get('channel') || '').trim(),
          period: String(data.get('period') || '').trim(),
          time: String(data.get('time') || '').trim(),
          episodes: String(data.get('episodes') || '').trim(),
          cast: String(data.get('cast') || '').trim(),
          staff: String(data.get('staff') || '').trim(),
          synopsis: String(data.get('synopsis') || '').trim(),
          thumbnail,
          youtubeUrl: String(data.get('youtubeUrl') || '').trim(),
          watchUrl: String(data.get('watchUrl') || '').trim(),
          featured: data.get('featured') === 'on',
          note: String(data.get('note') || '').trim(),
        }),
      });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || '저장 실패');
      form.reset();
      setStatus(`${name}을(를) 대기 목록에 넣었습니다.`, 'ok');
      showTab('queue');
    } catch (error) {
      const message = error instanceof Error ? error.message : '저장에 실패했습니다.';
      setStatus(
        message.includes('Failed to fetch')
          ? '저장 API가 없습니다. 터미널에서 npm run dev 로 사이트를 켜 주세요.'
          : message,
        'error',
      );
    }
  });
</script>
