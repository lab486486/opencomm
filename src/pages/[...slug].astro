---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import InArticleHeadingAd from '../components/InArticleHeadingAd.astro';
import InternalLinkCards from '../components/InternalLinkCards.astro';
import WatchBar from '../components/WatchBar.astro';
import FaqEnhance from '../components/FaqEnhance.astro';
import { getCategory } from '../lib/categories';
import { buildInternalLinkCatalog, cardsForBody } from '../lib/internalLinkCards';
import { entryPath, getShows, pageDescription } from '../lib/shows';

export async function getStaticPaths() {
  const entries = await getShows();
  return entries.map((entry) => ({
    params: { slug: entry.data.entrySlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const category = getCategory(entry.data.category);
const canonical = entry.data.canonical ?? entryPath(entry);
const allShows = await getShows();
const internalLinkCards = cardsForBody(String(entry.body ?? ''), buildInternalLinkCatalog(allShows));
// Channel guides should label the sticky CTA with the article subject (name),
// not a possibly-stale channel field copied from another post.
const watchLabel =
  entry.data.category === 'channel' && entry.data.name
    ? `${entry.data.name} 실시간 바로보기`
    : entry.data.channel
      ? `${entry.data.channel} 실시간 바로보기`
      : '실시간 바로보기';
---

<Base
  title={entry.data.title}
  description={pageDescription(entry)}
  canonical={canonical}
  image={entry.data.thumbnail}
>
  <div class="entry-layout">
    <article class="entry-article">
      <p class="breadcrumb">
        <a href="/">온에어 Live</a>
        {category && (
          <>
            / <a href={`/category/${category.slug}/`}>{category.name}</a>
          </>
        )}
        / {entry.data.name}
      </p>
      <h1 class="page-title">{entry.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
    </article>
    <aside class="entry-sidebar" aria-label="광고">
      <AdSlot adSlot="7907017315" label="오픈컴 Sidebar PC" width={300} height={600} />
    </aside>
  </div>

  {entry.data.watchUrl && <WatchBar href={entry.data.watchUrl} label={watchLabel} />}
  <InArticleHeadingAd />
  <InternalLinkCards cards={internalLinkCards} />
  <FaqEnhance />
  <script>
    document.querySelectorAll('.prose img').forEach((img) => {
      img.addEventListener('error', () => {
        const gallery = img.closest('.wp-gallery');
        img.remove();
        if (gallery && !gallery.querySelector('img')) gallery.remove();
      });
    });

    // WordPress leftover &nbsp; between CTA buttons becomes a grid/flex item and
    // forces mobile-style stacking on desktop — strip whitespace-only text nodes.
    document.querySelectorAll('.prose p').forEach((p) => {
      const buttons = p.querySelectorAll('a.fasc-button, a[style*="background-color"]');
      if (buttons.length < 2) return;
      [...p.childNodes].forEach((node) => {
        if (node.nodeType === Node.TEXT_NODE && /^[\s\u00A0]*$/.test(node.textContent || '')) {
          node.remove();
        }
      });
    });
  </script>
</Base>
