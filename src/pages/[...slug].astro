---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedShows from '../components/RelatedShows.astro';
import WatchBar from '../components/WatchBar.astro';
import FaqEnhance from '../components/FaqEnhance.astro';
import { getCategory } from '../lib/categories';
import { entryPath, getRelatedShows, getShows } from '../lib/shows';

export async function getStaticPaths() {
  const entries = await getShows();
  return entries.map((entry) => ({
    params: { slug: entry.data.entrySlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const related = await getRelatedShows(entry);
const category = getCategory(entry.data.category);
const canonical = entry.data.canonical ?? entryPath(entry);
const watchLabel = entry.data.channel
  ? `${entry.data.channel} 실시간 바로보기`
  : '실시간 바로보기';
---

<Base
  title={entry.data.title}
  description={entry.data.excerpt ?? entry.data.title}
  canonical={canonical}
  image={entry.data.thumbnail}
>
  <div class="entry-layout">
    <article class="entry-article">
      <p class="breadcrumb">
        <a href="/">온에어 Live</a>
        {category && (
          <>
            / <a href={`/category/${category.slug}/`}>{category.name}</a>
          </>
        )}
        / {entry.data.name}
      </p>
      <h1 class="page-title">{entry.data.title}</h1>
      {entry.data.excerpt && <p class="lede">{entry.data.excerpt}</p>}
      <div class="ad-inarticle">
        <AdSlot adSlot="5384795752" label="본문 중간" />
      </div>
      <div class="prose">
        <Content />
      </div>
    </article>
    <RelatedShows
      title={category?.name ?? '관련 글'}
      slug={category?.slug}
      entries={related}
    />
  </div>

  {entry.data.watchUrl && <WatchBar href={entry.data.watchUrl} label={watchLabel} />}
  <FaqEnhance />
</Base>
