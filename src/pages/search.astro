---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
---

<Base title="검색" description="온에어 Live에서 드라마, 예능, 채널을 찾습니다.">
  <section class="hero">
    <p class="kicker">SEARCH</p>
    <h1 class="page-title">통합 검색</h1>
    <SearchBox />
  </section>
  <section class="section">
    <p id="search-status" class="muted">검색어를 입력하면 제목, 방송국, 태그에서 찾습니다.</p>
    <div id="search-results" class="show-grid" style="margin-top: 16px;"></div>
  </section>
</Base>

<script>
  import Fuse from 'fuse.js';

  type Item = {
    name: string;
    title: string;
    excerpt: string;
    href: string;
    category: string;
    channel: string;
    date: string;
    thumbnail?: string;
    tags: string[];
  };

  const status = document.getElementById('search-status');
  const results = document.getElementById('search-results');
  const params = new URLSearchParams(window.location.search);
  const query = params.get('q')?.trim() ?? '';
  const input = document.querySelector<HTMLInputElement>('#q');
  if (input && query) input.value = query;

  function card(item: Item) {
    const thumb = item.thumbnail
      ? `<div class="show-thumb"><img src="${item.thumbnail}" alt="" width="640" height="400" loading="lazy" decoding="async" /></div>`
      : '';
    return `<article class="show-card"><a class="card-link" href="${item.href}">${thumb}<div class="show-body"><p class="meta">${item.category}${item.channel ? ` · ${item.channel}` : ''}</p><h3>${item.name}</h3></div></a></article>`;
  }

  const index = (await fetch('/search-index.json').then((response) => response.json())) as Item[];
  const fuse = new Fuse(index, {
    threshold: 0.35,
    keys: ['name', 'title', 'excerpt', 'tags', 'category', 'channel'],
  });

  if (query && status && results) {
    const matches = fuse.search(query).map((item) => item.item);
    status.textContent = matches.length
      ? `"${query}" 검색 결과 ${matches.length}개`
      : `"${query}"에 해당하는 글이 없습니다.`;
    results.innerHTML = matches.map(card).join('');
  }
</script>
